<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Feedback vibratorio al escanear (permiso normal, no se pide en tiempo de ejecución) -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Alertas de tareas nuevas y vencimientos (Android 13+ lo pide en tiempo de ejecución) -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:name=".ErpBodegaApplication"
        android:networkSecurityConfig="@xml/network_security_config_dev"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ERPBodega">
        <activity
            android:name=".auth.presentation.SetupActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".reception.presentation.ReceptionFormActivity" android:exported="false" />

        <activity
            android:name=".auth.presentation.LoginActivity"
            android:exported="false" />
        <activity
            android:name=".reception.presentation.ReceptionScanningActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".home.presentation.HomeActivity"
            android:exported="false" />
        <activity
            android:name=".reception.presentation.ReceptionListActivity"
            android:exported="false" />
        <activity
            android:name=".reception.presentation.ReceptionDetailActivity"
            android:exported="false" />

        <!-- Escaneo genérico (picking, despacho, conteo, transferencias) y consulta rápida -->
        <activity
            android:name=".core.scan.ScanSessionActivity"
            android:exported="false" />
        <activity
            android:name=".lookup.presentation.ProductLookupActivity"
            android:exported="false" />

        <activity
            android:name=".picking.presentation.PickingListActivity"
            android:exported="false" />
        <activity
            android:name=".dispatch.presentation.DispatchListActivity"
            android:exported="false" />
        <activity
            android:name=".count.presentation.CountListActivity"
            android:exported="false" />
        <activity
            android:name=".transfer.presentation.TransferListActivity"
            android:exported="false" />
        <activity
            android:name=".transfer.presentation.TransferFormActivity"
            android:exported="false" />
        <activity
            android:name=".adjustment.presentation.AdjustmentListActivity"
            android:exported="false" />
        <activity
            android:name=".adjustment.presentation.AdjustmentFormActivity"
            android:exported="false" />
        <activity
            android:name=".location.presentation.LocationStockActivity"
            android:exported="false" />
        <activity
            android:name=".location.presentation.RelocationActivity"
            android:exported="false" />
        <activity
            android:name=".dashboard.presentation.DashboardActivity"
            android:exported="false" />
        <activity
            android:name=".warehousemap.presentation.WarehouseMapActivity"
            android:exported="false" />

        <!-- Fotos de evidencia: la app de cámara escribe en el caché de la app vía este proveedor. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
    </application>

</manifest>