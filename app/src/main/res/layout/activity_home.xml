<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/surface_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- ===== Header: saludo + campana + avatar ===== -->
        <TextView
            android:id="@+id/tvGreeting"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary"
            tools:text="Hola, Pedro"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/ivBell" />

        <TextView
            android:id="@+id/tvRoleWarehouse"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textSize="13sp"
            android:textColor="@color/text_secondary"
            tools:text="Operario · Bodega central"
            app:layout_constraintTop_toBottomOf="@id/tvGreeting"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/ivBell" />

        <ImageView
            android:id="@+id/ivBell"
            android:layout_width="22dp"
            android:layout_height="22dp"
            android:src="@drawable/ic_bell_24"
            app:tint="@color/text_primary"
            android:contentDescription="@string/home_notifications_content_description"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/tvRoleWarehouse"
            app:layout_constraintEnd_toStartOf="@id/tvAvatar" />

        <TextView
            android:id="@+id/tvAvatar"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:layout_marginStart="10dp"
            android:background="@drawable/bg_avatar_circle"
            android:gravity="center"
            android:textColor="@color/on_accent"
            android:textSize="13sp"
            android:textStyle="bold"
            tools:text="PS"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/tvRoleWarehouse"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ===== Banner de sincronización ===== -->
        <LinearLayout
            android:id="@+id/layoutSyncBanner"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_sync_banner"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            app:layout_constraintTop_toBottomOf="@id/tvRoleWarehouse"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_check_circle_24"
                app:tint="@color/text_success"
                android:contentDescription="@null" />

            <TextView
                android:id="@+id/tvSyncStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textSize="13sp"
                android:textColor="@color/text_success"
                tools:text="Sincronizado · 3 tareas asignadas" />
        </LinearLayout>

        <!-- ===== Grilla de accesos (2 columnas x 3 filas) ===== -->
        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/gridMenu"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:columnCount="2"
            app:rowCount="3"
            app:layout_constraintTop_toBottomOf="@id/layoutSyncBanner"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <include
                android:id="@+id/btnRecepcion"
                layout="@layout/item_home_menu_button"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="12dp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

            <include
                android:id="@+id/btnPicking"
                layout="@layout/item_home_menu_button"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="12dp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

            <include
                android:id="@+id/btnDespacho"
                layout="@layout/item_home_menu_button"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="12dp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

            <include
                android:id="@+id/btnConteo"
                layout="@layout/item_home_menu_button"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="12dp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

            <include
                android:id="@+id/btnTransferencias"
                layout="@layout/item_home_menu_button"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_marginEnd="6dp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

            <include
                android:id="@+id/btnAjustes"
                layout="@layout/item_home_menu_button"
                android:layout_width="0dp"
                android:layout_height="110dp"
                android:layout_marginStart="6dp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

        </androidx.gridlayout.widget.GridLayout>

        <!-- ===== Botón Escanear ahora ===== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScanNow"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="16dp"
            android:text="@string/home_scan_now"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textColor="@color/on_accent"
            android:backgroundTint="@color/accent_fill"
            app:icon="@drawable/ic_scan_24"
            app:iconTint="@color/on_accent"
            app:iconGravity="textStart"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/gridMenu"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>