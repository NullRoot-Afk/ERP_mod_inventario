<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/surface_background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- ===== Card Superior de Usuario y Marca ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/surface_input"
            app:strokeWidth="1dp"
            app:strokeColor="@color/input_border"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="16dp">

                <ImageView
                    android:id="@+id/imgBrandLogo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:src="@drawable/ic_zenith_logo"
                    android:contentDescription="@string/app_logo_content_description"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintStart_toStartOf="parent" />

                <TextView
                    android:id="@+id/tvGreeting"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="12dp"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary"
                    tools:text="Hola, Luis Escare"
                    app:layout_constraintTop_toTopOf="@id/imgBrandLogo"
                    app:layout_constraintStart_toEndOf="@id/imgBrandLogo"
                    app:layout_constraintEnd_toStartOf="@id/ivBell" />

                <TextView
                    android:id="@+id/tvRoleWarehouse"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    tools:text="Operario · ZENITH Bodega Central"
                    app:layout_constraintTop_toBottomOf="@id/tvGreeting"
                    app:layout_constraintStart_toStartOf="@id/tvGreeting"
                    app:layout_constraintEnd_toStartOf="@id/ivBell" />

                <ImageView
                    android:id="@+id/ivBell"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_marginEnd="8dp"
                    android:src="@drawable/ic_bell_24"
                    app:tint="@color/text_primary"
                    android:contentDescription="@string/home_notifications_content_description"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toStartOf="@id/tvAvatar" />

                <TextView
                    android:id="@+id/tvAvatar"
                    android:layout_width="38dp"
                    android:layout_height="38dp"
                    android:background="@drawable/bg_avatar_circle"
                    android:gravity="center"
                    android:textColor="@color/on_accent"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="LE"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintBottom_toBottomOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Card Indicador de Estado Cloud ===== -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSyncBanner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/surface_input"
            app:strokeWidth="1dp"
            app:strokeColor="@color/border_accent"
            app:layout_constraintTop_toBottomOf="@id/cardHeader"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="14dp">

                <ImageView
                    android:id="@+id/ivSyncIcon"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_check_circle_24"
                    app:tint="@color/text_accent"
                    android:contentDescription="@null" />

                <TextView
                    android:id="@+id/tvSyncStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:textSize="13sp"
                    android:textColor="@color/text_primary"
                    tools:text="ZENITH Cloud Sincronizado · 3 tareas en turno" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- ===== Encabezado de Módulos ===== -->
        <TextView
            android:id="@+id/tvSectionTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/home_operations_title"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintTop_toBottomOf="@id/cardSyncBanner"
            app:layout_constraintStart_toStartOf="parent" />

        <!-- ===== Grilla de accesos ===== -->
        <androidx.gridlayout.widget.GridLayout
            android:id="@+id/gridMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:columnCount="2"
            app:rowCount="5"
            app:layout_constraintTop_toBottomOf="@id/tvSectionTitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <include
                android:id="@+id/btnRecepcion"
                layout="@layout/item_home_menu_button"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="12dp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

            <include
                android:id="@+id/btnPicking"
                layout="@layout/item_home_menu_button"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="12dp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

            <include
                android:id="@+id/btnDespacho"
                layout="@layout/item_home_menu_button"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="12dp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

            <include
                android:id="@+id/btnConteo"
                layout="@layout/item_home_menu_button"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="12dp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

            <include
                android:id="@+id/btnTransferencias"
                layout="@layout/item_home_menu_button"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="12dp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

            <include
                android:id="@+id/btnAjustes"
                layout="@layout/item_home_menu_button"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="12dp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

            <include
                android:id="@+id/btnUbicaciones"
                layout="@layout/item_home_menu_button"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_marginEnd="6dp"
                android:layout_marginBottom="12dp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

            <include
                android:id="@+id/btnDashboard"
                layout="@layout/item_home_menu_button"
                android:layout_width="0dp"
                android:layout_height="130dp"
                android:layout_marginStart="6dp"
                android:layout_marginBottom="12dp"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

            <!-- Ocupa la fila completa: mapa de bodegas + clima (API pública Open-Meteo) -->
            <include
                android:id="@+id/btnMapa"
                layout="@layout/item_home_menu_button"
                android:layout_width="0dp"
                android:layout_height="100dp"
                android:layout_marginBottom="12dp"
                app:layout_columnSpan="2"
                app:layout_columnWeight="1"
                app:layout_gravity="fill_horizontal" />

        </androidx.gridlayout.widget.GridLayout>

        <!-- ===== Botón Escanear ahora ===== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnScanNow"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="8dp"
            android:text="@string/home_scan_now"
            android:textAllCaps="false"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@color/on_accent"
            android:backgroundTint="@color/accent_fill"
            app:icon="@drawable/ic_scan_24"
            app:iconTint="@color/on_accent"
            app:iconGravity="textStart"
            app:cornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/gridMenu"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- ===== Cerrar sesión ===== -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="12dp"
            android:text="@string/home_logout"
            android:textAllCaps="false"
            android:textSize="15sp"
            android:textColor="@color/text_primary"
            app:icon="@drawable/ic_logout_24"
            app:iconTint="@color/text_primary"
            app:iconGravity="textStart"
            app:cornerRadius="12dp"
            app:strokeColor="@color/input_border"
            app:layout_constraintTop_toBottomOf="@id/btnScanNow"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
